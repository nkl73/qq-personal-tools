{
  "manifest_version": 3,
  "name": "QQ Personal Tools · ChatGPT 网页通道",
  "version": "0.9.0",
  "description": "将当前 QQ 个人账号会话的要求交给选定的 ChatGPT 网页，回传文字答复。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:18770/*", "https://chatgpt.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
